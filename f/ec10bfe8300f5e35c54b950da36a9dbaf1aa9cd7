/** Lattice floodlight tower: braced faces only, so you can dive the inside; lamp bank cantilevered towards the pitch. */\r
function floodTower(kit: WorldKit, x: number, z: number, aimX: number, aimZ: number, h: number) {\r
  const yaw = Math.atan2(aimX - x, aimZ - z);\r
  // Open at the foot on the side facing the pitch (face 2 is +z before the yaw turns it to the aim).\r
  latticeTower(kit, x, 0, z, { h, base: 5, top: 3.2, mat: 'steelGrey', leg: 0.16, brace: 0.06, step: 5, yaw, portal: [2], portalH: 7 });\r
  const fx = Math.sin(yaw), fz = Math.cos(yaw);\r
  const hx = x + fx * 2.9, hz = z + fz * 2.9;\r
  // Cantilevered platform and the lamp bank leaning towards the pitch.\r
  kit.box('metalDark', x + fx * 2.2, h - 0.1, z + fz * 2.2, 5, 0.12, 1.5, { yaw });\r
  // (its lower edge sits on the platform)\r
  kit.box('steelGrey', hx, h + 1.85, hz, 6.4, 4, 0.5, { rot: new THREE.Euler(0.45, yaw, 0, 'YXZ') });\r
  kit.box('lampWhite', hx + fx * 0.24, h + 1.73, hz + fz * 0.24, 5.8, 3.5, 0.05, { rot: new THREE.Euler(0.45, yaw, 0, 'YXZ'), collide: false, shadow: false });\r
  kit.box('ledRed', x, h + 0.2, z, 0.2, 0.2, 0.2, { collide: false, shadow: false });\r
  // The middle of the top ring member on the pitch side (cables hook on there).\r
  return { top: V(x, h, z), ring: V(x + fx * 1.6, h, z + fz * 1.6) };\r
}\r
