const PANTS = ['#1f2a44', '#24324f', '#141414', '#2a2a2a', '#4b4f55', '#5a4c3a', '#3a3f4a', '#26364f', '#6b6155'];\r
const HOME_SHIRTS = [HOME.colour, HOME.colour, HOME.colour, '#a50d24', '#f2f2f2', '#141414'];\r
const AWAY_SHIRTS = [AWAY.colour, AWAY.colour, AWAY.colour, '#1b2a4a', '#ffffff'];\r
/** Scarf colours (accent palette, index = Fan.accent). */\r
const ACCENTS = [HOME.colour, '#f4f4f4', AWAY.colour, '#1b2a4a', '#141414', '#ffcf3f', '#2a8a4a', '#8c8f93'];\r
\r
function makeFan(r: () => number, kind: 'home' | 'away' | 'neutral' | 'staff', o: { stand?: number; scarf?: number; wave?: number } = {}): Fan {\r
  const pick = <T,>(a: T[]) => a[Math.floor(r() * a.length)];\r
  let flags = 0;\r
  if (o.stand && r() < o.stand) flags |= 1;\r
  if (r() < (o.wave ?? 0.02)) flags |= 2;\r
  const scarf = r() < (o.scarf ?? 0);\r
  if (scarf) flags |= 4;\r
  const shirt = kind === 'home' ? pick(HOME_SHIRTS) : kind === 'away' ? pick(AWAY_SHIRTS) : pick(NEUTRAL);\r
  return {\r
    shirt,\r
    pants: pick(PANTS),\r
    skin: Math.floor(r() * 8),\r
    hair: Math.floor(r() * 8),\r
    accent: kind === 'away' ? (r() < 0.7 ? 2 : 3) : kind === 'home' ? (r() < 0.75 ? 0 : 1) : Math.floor(r() * 8),\r
    shoe: r() * 0.4,\r
    shortSleeves: kind !== 'neutral' && r() < 0.55,\r
    team: kind === 'home' ? 1 : kind === 'away' ? 2 : kind === 'staff' ? 3 : 0,\r
    flags,\r
    phase: r(),\r
    scale: 0.94 + r() * 0.12,\r
  };\r
}\r
