/** Striped turf, line markings, goals with nets and corner flags. */\r
function buildPitch(kit: WorldKit) {\r
  // Turf: stripes across the length (vertex colour times the grass texture), run-off a touch darker.\r
  {\r
    const pos: number[] = [], uv: number[] = [], col: number[] = [], idx: number[] = [];\r
    const X0 = -56.4, X1 = 56.4, Z0 = -36.8, Z1 = 36.8;\r
    const xs = [X0, -PL / 2];\r
    for (let k = 1; k < 20; k++) xs.push(-PL / 2 + k * (PL / 20));\r
    xs.push(PL / 2, X1);\r
    const zs = [Z0, -PW / 2, PW / 2, Z1];\r
    const c = new THREE.Color();\r
    for (let i = 0; i < xs.length - 1; i++) {\r
      for (let j = 0; j < zs.length - 1; j++) {\r
        const inside = i > 0 && i < xs.length - 2 && j === 1;\r
        const stripe = (i - 1) % 2 === 0;\r
        if (inside) c.setRGB(stripe ? 1.12 : 0.8, stripe ? 1.9 : 1.42, stripe ? 1.26 : 0.94);\r
        else c.setRGB(0.84, 1.42, 0.98);\r
        const b = pos.length / 3;\r
        for (const [x, z] of [[xs[i], zs[j]], [xs[i + 1], zs[j]], [xs[i + 1], zs[j + 1]], [xs[i], zs[j + 1]]]) {\r
          pos.push(x, 0.012, z);\r
          uv.push(x / 3.2, z / 3.2);\r
          col.push(c.r, c.g, c.b);\r
        }\r
        idx.push(b, b + 2, b + 1, b, b + 3, b + 2);\r
      }\r
    }\r
    const g = new THREE.BufferGeometry();\r
    g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));\r
    g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));\r
    g.setAttribute('color', new THREE.Float32BufferAttribute(col, 3));\r
    g.setIndex(idx);\r
    g.computeVertexNormals();\r
    const mat = new THREE.MeshStandardMaterial({ map: Tex.grass().map, vertexColors: true, roughness: 0.95, polygonOffset: true, polygonOffsetFactor: -1, polygonOffsetUnits: -2 });\r
    kit.addMerged(mat, g, false);\r
  }\r
  // Markings.\r
  {\r
    const pos: number[] = [], idx: number[] = [];\r
    const W = 0.06, Y = 0.02;\r
    const quad = (ax: number, az: number, bx: number, bz: number, w = W) => {\r
      const dx = bx - ax, dz = bz - az, l = Math.hypot(dx, dz) || 1, nx = (-dz / l) * w, nz = (dx / l) * w;\r
      const b = pos.length / 3;\r
      pos.push(ax + nx, Y, az + nz, bx + nx, Y, bz + nz, bx - nx, Y, bz - nz, ax - nx, Y, az - nz);\r
      idx.push(b, b + 2, b + 1, b, b + 3, b + 2);\r
    };\r
    const arc = (cx: number, cz: number, r: number, a0: number, a1: number) => {\r
      const n = Math.max(4, Math.round(Math.abs(a1 - a0) * r * 1.5));\r
      for (let k = 0; k < n; k++) {\r
        const t0 = a0 + ((a1 - a0) * k) / n, t1 = a0 + ((a1 - a0) * (k + 1)) / n;\r
        quad(cx + Math.cos(t0) * r, cz + Math.sin(t0) * r, cx + Math.cos(t1) * r, cz + Math.sin(t1) * r);\r
      }\r
    };\r
    const hx = PL / 2, hz = PW / 2;\r
    quad(-hx - W, -hz, hx + W, -hz); quad(-hx - W, hz, hx + W, hz); quad(-hx, -hz, -hx, hz); quad(hx, -hz, hx, hz); quad(0, -hz, 0, hz);\r
    arc(0, 0, 9.15, 0, Math.PI * 2);\r
    arc(0, 0, 0.08, 0, Math.PI * 2);\r
    for (const e of [-1, 1]) {\r
      const bx = e * (hx - 16.5), gx = e * (hx - 5.5);\r
      quad(e * hx, -20.16, bx, -20.16); quad(e * hx, 20.16, bx, 20.16); quad(bx, -20.16, bx, 20.16);\r
      quad(e * hx, -9.16, gx, -9.16); quad(e * hx, 9.16, gx, 9.16); quad(gx, -9.16, gx, 9.16);\r
      const sx = e * (hx - 11);\r
      arc(sx, 0, 0.08, 0, Math.PI * 2);\r
      // The D outside the box.\r
      const a = Math.acos(5.5 / 9.15);\r
      if (e > 0) arc(sx, 0, 9.15, Math.PI - a, Math.PI + a);\r
      else arc(sx, 0, 9.15, -a, a);\r
      for (const s of [-1, 1]) {\r
        const a0 = e > 0 ? (s > 0 ? Math.PI / 2 : Math.PI) : (s > 0 ? 0 : -Math.PI / 2);\r
        arc(e * hx, s * hz, 1, a0, a0 + Math.PI / 2);\r
      }\r
    }\r
    const g = new THREE.BufferGeometry();\r
    g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));\r
    g.setIndex(idx);\r
    g.computeVertexNormals();\r
    const mat = new THREE.MeshStandardMaterial({ color: 0xf4f4f0, roughness: 0.85, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -4 });\r
    kit.addMerged(mat, g, false);\r
  }\r
  // Goals: posts and bar, a box-and-slope net on a light frame (the net itself is soft: no collider).\r
  {\r
    const netGeos: THREE.BufferGeometry[] = [];\r
    const quad = (a: THREE.Vector3, b: THREE.Vector3, c: THREE.Vector3, d: THREE.Vector3) => {\r
      const g = new THREE.BufferGeometry();\r
      const ua = 0.96, wAB = a.distanceTo(b) / ua, hAD = a.distanceTo(d) / ua;\r
      g.setAttribute('position', new THREE.Float32BufferAttribute([a.x, a.y, a.z, b.x, b.y, b.z, c.x, c.y, c.z, d.x, d.y, d.z], 3));\r
      g.setAttribute('uv', new THREE.Float32BufferAttribute([0, 0, wAB, 0, wAB, hAD, 0, hAD], 2));\r
      g.setIndex([0, 1, 2, 0, 2, 3]);\r
      g.computeVertexNormals();\r
      netGeos.push(g);\r
    };\r
    for (const e of [-1, 1]) {\r
      const gx = e * (PL / 2 + 0.06), top = 2.44, d1 = e * 1.0, d2 = e * 2.0;\r
      for (const z of [-3.66, 3.66]) kit.pipe('white', V(gx, 0, z), V(gx, top, z), 0.06, { seg: 12 });\r
      kit.pipe('white', V(gx, top, -3.72), V(gx, top, 3.72), 0.06, { seg: 12 });\r
      const fr = (a: THREE.Vector3, b: THREE.Vector3) => kit.pipe('white', a, b, 0.022, { seg: 5 });\r
      fr(V(gx + d1, top, -3.66), V(gx + d1, top, 3.66));\r
      for (const z of [-3.66, 3.66]) {\r
        fr(V(gx, top, z), V(gx + d1, top, z));\r
        fr(V(gx + d1, top, z), V(gx + d2, 0.02, z));\r
        fr(V(gx, 0.02, z), V(gx + d2, 0.02, z));\r
      }\r
      fr(V(gx + d2, 0.02, -3.66), V(gx + d2, 0.02, 3.66));\r
      quad(V(gx, top, -3.66), V(gx, top, 3.66), V(gx + d1, top, 3.66), V(gx + d1, top, -3.66));\r
      quad(V(gx + d1, top, -3.66), V(gx + d1, top, 3.66), V(gx + d2, 0.02, 3.66), V(gx + d2, 0.02, -3.66));\r
      for (const z of [-3.66, 3.66]) {\r
        // Side nets: a box part and a sloping part.\r
        quad(V(gx, 0.02, z), V(gx + d1, 0.02, z), V(gx + d1, top, z), V(gx, top, z));\r
        quad(V(gx + d1, 0.02, z), V(gx + d2, 0.02, z), V(gx + d2, 0.02, z), V(gx + d1, top, z));\r
      }\r
    }\r
    const g = mergeGeometries(netGeos, false);\r
    netGeos.forEach((x) => x.dispose());\r
    if (g) kit.addMerged(new THREE.MeshStandardMaterial({ map: netTexture(), alphaTest: 0.4, side: THREE.DoubleSide, roughness: 0.9 }), g, false);\r
    // Corner flags.\r
    for (const sx of [-1, 1]) for (const sz of [-1, 1]) {\r
      kit.cylinder('white', sx * PL / 2, 0, sz * PW / 2, 0.018, 1.5, { seg: 6 });\r
      kit.box('steelRed', sx * PL / 2 + sx * 0.2, 1.36, sz * PW / 2, 0.38, 0.26, 0.012, { collide: false });\r
    }\r
  }\r
}\r
\r
/** Tartan running track round the pitch (between the boards and the stands), rounded in the corners. */\r
function buildRunningTrack(kit: WorldKit) {\r
  const geos: THREE.BufferGeometry[] = [];\r
  const strip = (x0: number, x1: number, z0: number, z1: number) => {\r
    const g = new THREE.PlaneGeometry(x1 - x0, z1 - z0);\r
    g.rotateX(-Math.PI / 2);\r
    g.translate((x0 + x1) / 2, 0.016, (z0 + z1) / 2);\r
    const uv = g.attributes.uv as THREE.BufferAttribute;\r
    for (let i = 0; i < uv.count; i++) uv.setXY(i, uv.getX(i) * (x1 - x0) / 3, uv.getY(i) * (z1 - z0) / 3);\r
    geos.push(g);\r
  };\r
  strip(-57.5, 57.5, -41.75, -37.3);\r
  strip(-57.5, 57.5, 37.3, 41.75);\r
  strip(-62.25, -56.8, -37, 37);\r
  strip(56.8, 62.25, -37, 37);\r
  for (const sx of [-1, 1]) for (const sz of [-1, 1]) {\r
    const cx = sx * 57.5, cz = sz * 37, n = 10, R = 4.75;\r
    const pos: number[] = [cx, 0.016, cz], uv: number[] = [cx / 3, cz / 3];\r
    for (let k = 0; k <= n; k++) {\r
      const a = (k / n) * (Math.PI / 2);\r
      const x = cx + sx * Math.sin(a) * R, z = cz + sz * Math.cos(a) * R;\r
      pos.push(x, 0.016, z);\r
      uv.push(x / 3, z / 3);\r
    }\r
    const idx: number[] = [];\r
    for (let k = 0; k < n; k++) idx.push(0, k + 1, k + 2);\r
    const g = new THREE.BufferGeometry();\r
    g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));\r
    g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));\r
    g.setIndex(idx);\r
    // Face up.\r
    g.computeVertexNormals();\r
    if ((g.attributes.normal as THREE.BufferAttribute).getY(0) < 0) {\r
      for (let i = 0; i < idx.length; i += 3) [idx[i + 1], idx[i + 2]] = [idx[i + 2], idx[i + 1]];\r
      g.setIndex(idx);\r
      g.computeVertexNormals();\r
    }\r
    geos.push(g);\r
  }\r
  const g = mergeGeometries(geos, false);\r
  geos.forEach((x) => x.dispose());\r
  if (g) kit.addMerged(new THREE.MeshStandardMaterial({ map: tartanTexture(), roughness: 0.92, polygonOffset: true, polygonOffsetFactor: -1, polygonOffsetUnits: -2 }), g, false);\r
}\r
