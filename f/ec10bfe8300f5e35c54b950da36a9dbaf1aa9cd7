// ------------------------------------------------------------------------------------------ menu fly-by\r
\r
/**\r
 * Menu fly-by following the match like a camera drone. The app eases its camera along a Catmull-Rom loop\r
 * through \`points\`, looking at the point two ahead: each frame this works out where on the loop the\r
 * camera is and moves the points so the next frame lands on the shot it wants, looking at the ball.\r
 * Off the loop (first frame, flying) it parks a ring of points round the ball.\r
 */\r
class FlybyDirector {\r
  readonly points: THREE.Vector3[];\r
  private readonly n = 6;\r
  private lastT = Number.NaN;\r
  private readonly tmp = new THREE.Vector3();\r
  private readonly a = new THREE.Vector3();\r
  private readonly want = new THREE.Vector3();\r
  private readonly look = new THREE.Vector3();\r
  private readonly aim = new THREE.Vector3();\r
  private heading = 0;\r
\r
  constructor(private target: () => { pos: THREE.Vector3; vel: THREE.Vector3 } | null, private orbit: THREE.Vector3[]) {\r
    this.points = orbit.map((p) => p.clone());\r
  }\r
\r
  private cr(i: number, u: number, out: THREE.Vector3) {\r
    const n = this.n, Pt = this.points;\r
    const a = Pt[(i - 1 + n) % n], b = Pt[i % n], c = Pt[(i + 1) % n], d = Pt[(i + 2) % n];\r
    const f = (p0: number, p1: number, p2: number, p3: number) =>\r
      0.5 * (2 * p1 + (-p0 + p2) * u + (2 * p0 - 5 * p1 + 4 * p2 - p3) * u * u + (-p0 + 3 * p1 - 3 * p2 + p3) * u * u * u);\r
    return out.set(f(a.x, b.x, c.x, d.x), f(a.y, b.y, c.y, d.y), f(a.z, b.z, c.z, d.z));\r
  }\r
\r
  private locate(cam: THREE.Vector3) {\r
    let bi = 0, bu = 0, best = Infinity;\r
    for (let i = 0; i < this.n; i++) for (let k = 0; k <= 30; k++) {\r
      const d = this.cr(i, k / 30, this.tmp).distanceToSquared(cam);\r
      if (d < best) {\r
        best = d;\r
        bi = i;\r
        bu = k / 30;\r
      }\r
    }\r
    let lo = Math.max(0, bu - 1 / 30), hi = Math.min(1, bu + 1 / 30);\r
    for (let k = 0; k < 20; k++) {\r
      const m1 = lo + (hi - lo) / 3, m2 = hi - (hi - lo) / 3;\r
      if (this.cr(bi, m1, this.tmp).distanceToSquared(cam) < this.cr(bi, m2, this.tmp).distanceToSquared(cam)) hi = m2;\r
      else lo = m1;\r
    }\r
    const u = (lo + hi) / 2;\r
    return { i: bi, u, err: this.cr(bi, u, this.tmp).distanceTo(cam) };\r
  }\r
\r
  update(t: number, cam: THREE.Vector3) {\r
    let dt = t - this.lastT;\r
    if (!(dt > 0 && dt < 0.5)) dt = 1 / 60;\r
    this.lastT = t;\r
    const tg = this.target();\r
    if (!tg) {\r
      for (let i = 0; i < this.n; i++) this.points[i].copy(this.orbit[i]);\r
      return;\r
    }\r
    // Smoothed aim point a little above the ball, smoothed heading of play.\r
    if (!Number.isFinite(this.aim.x) || this.aim.lengthSq() === 0) this.aim.copy(tg.pos);\r
    this.aim.lerp(tg.pos, Math.min(1, dt * 1.6));\r
    const sp = Math.hypot(tg.vel.x, tg.vel.z);\r
    if (sp > 2) {\r
      let d = Math.atan2(tg.vel.x, tg.vel.z) - this.heading;\r
      d = Math.atan2(Math.sin(d), Math.cos(d));\r
      this.heading += d * Math.min(1, dt * 0.4);\r
    }\r
    const hit = this.locate(cam);\r
    if (hit.err > 0.75) {\r
      for (let i = 0; i < this.n; i++) {\r
        const a = (i / this.n) * Math.PI * 2;\r
        this.points[i].set(this.aim.x + Math.cos(a) * 24, 12, this.aim.z + Math.sin(a) * 24);\r
      }\r
      return;\r
    }\r
    // The shot: swing slowly round the play at 18-26 m, 7-12 m up.\r
    const ang = this.heading + Math.PI + 1.2 * Math.sin(t * 0.045);\r
    const rr = 22 + 4 * Math.sin(t * 0.07);\r
    this.want.set(this.aim.x + Math.sin(ang) * rr, 9 + 3 * Math.sin(t * 0.05), this.aim.z + Math.cos(ang) * rr);\r
    this.want.x = Math.max(-70, Math.min(70, this.want.x));\r
    this.want.z = Math.max(-46, Math.min(46, this.want.z));\r
    // The app looks 3 m below the point it aims at.\r
    this.look.set(this.aim.x, this.aim.y + 3.4, this.aim.z);\r
    this.a.subVectors(this.look, this.want).setY(0).normalize().multiplyScalar(-3);\r
    this.a.set(-this.a.z, 0, this.a.x);\r
    const n = this.n, i = hit.i;\r
    const u = Math.min(0.9999, hit.u + Math.min(dt, 0.1) * 0.035 * n);\r
    const w3 = 0.5 * (u * u * u - u * u);\r
    const Pt = this.points, a = this.a;\r
    const X = this.tmp.copy(this.want).addScaledVector(this.look, -w3).addScaledVector(a, w3 * (2 - u)).multiplyScalar(1 / (1 - w3));\r
    Pt[(i - 1 + n) % n].copy(X).addScaledVector(a, -(1 + u));\r
    Pt[i % n].copy(X).addScaledVector(a, -u);\r
    Pt[(i + 1) % n].copy(X).addScaledVector(a, 1 - u);\r
    for (let k = 2; k < n - 1; k++) Pt[(i + k) % n].copy(this.look);\r
  }\r
}\r
