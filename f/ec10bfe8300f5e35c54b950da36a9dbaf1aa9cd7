/** Scoreboard picture: team names, score, minute, and a GOAL flash. */\r
function drawBoard(g: CanvasRenderingContext2D, score: [number, number], clock: string, goal: number) {\r
  const W = 1024, H = 384;\r
  g.fillStyle = '#04060a';\r
  g.fillRect(0, 0, W, H);\r
  if (goal >= 0) {\r
    g.fillStyle = goal === 0 ? HOME.colour : AWAY.colour;\r
