/** Printed banners in one atlas (one draw): three for the home end, the arch banner in the bottom row. */\r
function bannerMaterial() {\r
  const tex = cachedTex('banners', () => canvasTexture(2048, 512, (g) => {\r
    const rows: [string, string, string][] = [['QUADLINE ULTRAS', HOME.colour, '#ffffff'], ['WE FLY TOGETHER', '#141414', HOME.colour], ['RED ARMY  1897', '#ffffff', HOME.colour], ['QUADLINE FPV', '#101418', '#ffcf3f']];\r
    rows.forEach(([text, bg, fg], i) => {\r
      g.fillStyle = bg;\r
      g.fillRect(0, i * 128, 2048, 128);\r
      g.fillStyle = fg;\r
      g.font = '900 100px "Segoe UI", Arial Black, sans-serif';\r
      g.textAlign = 'center';\r
      g.textBaseline = 'middle';\r
      g.fillText(text, 1024, i * 128 + 68);\r
    });\r
  }));\r
  return new THREE.MeshStandardMaterial({ map: tex, roughness: 0.8 });\r
}\r
\r
/** Ramp up the back of a stand from the ground to a concourse doorway: landing, sloping deck, parapets, piers. */\r
function ramp(kit: WorldKit, f: StandFrame, sDoor: number, dirS: number, ko: Keepout): boolean {\r
  const u0 = 22.5, u1 = 25.5, top = HALL.floor, run = 26;\r
  const sA = sDoor + dirS * 2.4, sB = sA + dirS * run;\r
  const um = (u0 + u1) / 2;\r
  const lx = f.x(sDoor, (BACK_WALL.u1 + u1) / 2), lz = f.z(sDoor, (BACK_WALL.u1 + u1) / 2);\r
  const mx = f.x((sA + sB) / 2, um), mz = f.z((sA + sB) / 2, um);\r
  if (!ko.okBox(lx, lz, 4.8, u1 - BACK_WALL.u1, f.yaw, 0, top + 1.2) || !ko.okBox(mx, mz, run, u1 - u0, f.yaw, 0, top + 1.2)) return false;\r
  kit.box('concreteNew', lx, top - 0.15, lz, 4.8, 0.3, u1 - BACK_WALL.u1, { yaw: f.yaw });\r
  // Deck (top surface on the line), then parapets either side.\r
  const A = f.p(sA, um, top), B = f.p(sB, um, 0);\r
  const dn = (p: THREE.Vector3, d: number) => p.clone().setY(p.y - d);\r
  kit.beam('concreteNew', dn(A, 0.15), dn(B, 0.15), u1 - u0, 0.3);\r
  for (const u of [u0 + 0.1, u1 - 0.1]) kit.beam('concreteNew', f.p(sA, u, top + 0.5), f.p(sB, u, 0.5), 0.2, 1.1);\r
  for (const s of [sDoor - 2.4, sDoor + 2.4]) {\r
    if ((s - sDoor) * dirS > 0) continue;\r
    kit.box('concreteNew', f.x(s, (BACK_WALL.u1 + u1) / 2), top + 0.55, f.z(s, (BACK_WALL.u1 + u1) / 2), 0.2, 1.1, u1 - BACK_WALL.u1, { yaw: f.yaw });\r
  }\r
  kit.box('concreteNew', f.x(sDoor, u1 - 0.1), top + 0.55, f.z(sDoor, u1 - 0.1), 4.8, 1.1, 0.2, { yaw: f.yaw });\r
  // Piers under the landing and the deck.\r
  for (const s of [sDoor - 1.8, sDoor + 1.8]) kit.box('concreteNew', f.x(s, u1 - 0.6), (top - 0.3) / 2, f.z(s, u1 - 0.6), 0.5, top - 0.3, 0.5, { yaw: f.yaw });\r
  for (let k = 1; k <= 3; k++) {\r
    const s = sA + dirS * run * (k / 4);\r
    const y = top * (1 - k / 4) - 0.3;\r
    if (y < 0.4) continue;\r
    kit.box('concreteNew', f.x(s, um), y / 2, f.z(s, um), 0.5, y, u1 - u0 - 0.6, { yaw: f.yaw });\r
  }\r
  return true;\r
}\r
