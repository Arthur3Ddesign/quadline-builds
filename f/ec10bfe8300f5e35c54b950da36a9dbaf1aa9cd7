/** Pitch-side LED advertising boards, merged per texture, with a box collider per board. */\r
function adBoards(kit: WorldKit, boards: { x: number; z: number; yaw: number; len: number }[]) {\r
  const ads: [string, string, string][] = [['VOLTLINE', '#111111', '#ffcc00'], ['KITE PROPS', '#002a3a', '#2ad1ff'], ['QUADLINE FPV', '#0b1020', '#29e6ff'], ['PULSAR', '#2a0008', '#ff4060']];\r
  const mats = ads.map(([t, bg, fg]) => {\r
    const tex = canvasTexture(1024, 128, (g) => {\r
      g.fillStyle = bg;\r
      g.fillRect(0, 0, 1024, 128);\r
      g.fillStyle = fg;\r
      g.font = '900 92px "Segoe UI", Arial Black, sans-serif';\r
      g.textAlign = 'center';\r
      g.textBaseline = 'middle';\r
      g.fillText(t, 512, 68);\r
    });\r
    const m = new THREE.MeshStandardMaterial({ map: tex, emissive: 0xffffff, emissiveMap: tex, emissiveIntensity: 0.9, roughness: 0.5 });\r
    return kit.nightGlow(m, 1.5, 0.7);\r
  });\r
  const parts: THREE.BufferGeometry[][] = ads.map(() => []);\r
  boards.forEach((b, i) => {\r
    kit.box('black', b.x, 0.5, b.z, b.len, 1, 0.3, { yaw: b.yaw });\r
    // Screen on the pitch-facing side.\r
    const g = new THREE.PlaneGeometry(b.len - 0.1, 0.85);\r
    g.rotateY(b.yaw);\r
    g.translate(b.x + Math.sin(b.yaw) * 0.16, 0.52, b.z + Math.cos(b.yaw) * 0.16);\r
    parts[i % ads.length].push(g);\r
  });\r
  parts.forEach((list, i) => {\r
    if (!list.length) return;\r
    const g = mergeGeometries(list, false);\r
    list.forEach((x) => x.dispose());\r
    if (g) kit.mesh(new THREE.Mesh(g, mats[i]));\r
  });\r
}\r
