.champ { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 16px; margin-bottom: 26px; }
.champ-full { grid-column: 1 / -1; }
.champ h3 { margin: 0 0 8px; }
.champ-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; grid-column: 1 / -1; }
.champ-head h3 { margin: 0; font-size: 20px; }
.champ-head .muted { font-size: 13.5px; }
.champ .panel { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px; }
.round-next { border-color: rgba(255, 207, 63, 0.45); }
.round-next .kind { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-ink); background: var(--accent); padding: 2px 8px; border-radius: 99px; margin-right: 8px; vertical-align: 2px; }
.round-next b.title { font-size: 18px; }
.round-next p { margin: 0; color: #dde2ea; font-size: 14px; line-height: 1.5; }
.cal { display: flex; flex-direction: column; }
.cal-row { display: grid; grid-template-columns: 2.2em 1fr auto; gap: 8px; align-items: baseline; padding: 6px 0; border-top: 1px solid var(--line); font-size: 13.5px; }
.cal-row .n { color: var(--muted); font-family: var(--mono); }
.cal-row small { color: var(--muted); display: block; font-size: 12px; }
.cal-row .res { font-family: var(--mono); font-weight: 800; }
.cal-row.next { color: var(--accent); }
.cal-row.done .res.p1 { color: var(--accent); }
.st-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
.st-table th { text-align: left; color: var(--muted); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; padding: 3px 6px; }
.st-table td { padding: 5px 6px; border-top: 1px solid var(--line); }
.st-table td.n, .st-table td.p { font-family: var(--mono); }
.st-table td.p { font-weight: 800; text-align: right; }
.st-table th.p { text-align: right; }
.st-table tr.you td { color: var(--accent); font-weight: 700; }
.st-table tr.up td:first-child { box-shadow: inset 3px 0 0 var(--good); }
.st-table tr.down td:first-child { box-shadow: inset 3px 0 0 var(--bad); }
.st-table .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 7px; }
.st-key { font-size: 11.5px; color: var(--muted); }
.st-key i { display: inline-block; width: 10px; height: 3px; vertical-align: 3px; margin: 0 4px 0 8px; }
.sponsor-line { font-size: 13.5px; color: #dde2ea; line-height: 1.5; }
.sponsor-line b { color: var(--text); }
.sponsors { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin: 8px 0 18px; }
.sponsor { display: flex; flex-direction: column; gap: 6px; }
.sponsor b { font-size: 17px; }
.sponsor .terms { font-size: 13.5px; line-height: 1.6; }
.sponsor .terms div { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding: 3px 0; }
.sponsor .terms span:last-child { font-family: var(--mono); color: var(--good); }
.job-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; border-top: 1px solid var(--line); padding: 6px 0; font-size: 13.5px; }
.job-row small { display: block; color: var(--muted); }
.season-end-msg { font-size: 18px; margin: 4px 0 14px; }
.season-end-msg.up { color: var(--good); }
.season-end-msg.down { color: var(--bad); }
.round-results { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 340px); gap: 22px; align-items: start; }
.round-results .results-table { width: 100%; }
.round-results .payout { width: 100%; }
@media (max-width: 900px) { .champ, .round-results { grid-template-columns: 1fr; } }
