.film-hud { position: absolute; inset: 0; pointer-events: none; white-space: nowrap; }
.film-frame { position: absolute; width: 4.2vmin; height: 4.2vmin; border: 2px solid rgba(255,255,255,0.7); filter: drop-shadow(0 0 1px #000); }
.film-frame.tl { left: 2.2%; top: 3%; border-right: 0; border-bottom: 0; }
.film-frame.tr { right: 2.2%; top: 3%; border-left: 0; border-bottom: 0; }
.film-frame.bl { left: 2.2%; bottom: 3%; border-right: 0; border-top: 0; }
.film-frame.br { right: 2.2%; bottom: 3%; border-left: 0; border-top: 0; }
.film-dot { display: inline-block; width: 0.62em; height: 0.62em; border-radius: 50%; background: #ff2d3d; box-shadow: 0 0 6px #ff2d3d; margin-right: 0.35em; vertical-align: 0.04em; animation: film-blink 1s steps(2, start) infinite; }
.film-dot.off { background: #9aa0aa; box-shadow: none; animation: none; }
@keyframes film-blink { to { visibility: hidden; } }
.film-box { position: absolute; display: none; color: #8dffb0; }
.film-box i { position: absolute; width: 26%; height: 26%; border: 2px solid currentColor; filter: drop-shadow(0 0 1px #000); }
.film-box i:nth-child(1) { left: 0; top: 0; border-right: 0; border-bottom: 0; }
.film-box i:nth-child(2) { right: 0; top: 0; border-left: 0; border-bottom: 0; }
.film-box i:nth-child(3) { left: 0; bottom: 0; border-right: 0; border-top: 0; }
.film-box i:nth-child(4) { right: 0; bottom: 0; border-left: 0; border-top: 0; }
.film-tag { position: absolute; left: 50%; bottom: 100%; transform: translate(-50%, -0.35em); font-size: 0.72em; color: #fff; }
.film-tag em { font-style: normal; display: inline-block; width: 0.6em; height: 0.6em; border-radius: 50%; margin-right: 0.35em; vertical-align: 0.05em; }
.film-arrow { position: absolute; display: none; transform-origin: 0 0; font-size: 0.75em; color: #fff; }
.film-arrow b { position: absolute; left: -9px; top: -9px; width: 0; height: 0; border: 9px solid transparent; border-left: 15px solid #ffcf3f; filter: drop-shadow(0 0 1px #000); }
.film-arrow span { position: absolute; left: 50%; top: 14px; transform: translateX(-50%); }
.film-meter { position: absolute; left: 50%; bottom: 13%; transform: translateX(-50%); width: min(30vw, 360px); text-align: center; font-size: 0.85em; }
.film-bar { position: relative; height: 0.6em; margin: 0.3em 0; background: rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.55); }
.film-bar div { position: absolute; left: 0; top: 0; bottom: 0; background: currentColor; }
.film-bar s { position: absolute; top: -2px; bottom: -2px; width: 2px; background: rgba(255,255,255,0.7); text-decoration: none; }
.film-sub { font-size: 0.8em; opacity: 0.85; }
