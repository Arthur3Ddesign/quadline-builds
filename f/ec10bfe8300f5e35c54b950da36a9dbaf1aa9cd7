.lb { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.lb-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.lb-head b { font-size: 15px; }
.lb-scopes { display: flex; gap: 2px; flex-wrap: wrap; }
.lb-scopes .tab { padding: 6px 10px; font-size: 12.5px; }
.lb-scopes .tab:disabled { opacity: 0.35; cursor: default; }
.lb-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
.lb-table th { text-align: left; color: var(--muted); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 8px; }
.lb-table td { padding: 6px 8px; border-top: 1px solid var(--line); white-space: nowrap; }
.lb-table td.n { font-family: var(--mono); color: var(--muted); width: 3.2em; }
.lb-table td.s { font-family: var(--mono); font-weight: 700; }
.lb-table td.d { color: var(--muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; max-width: 14em; }
.lb-table td.a { text-align: right; }
.lb-table td.a .btn { padding: 3px 8px; font-size: 12px; margin-left: 4px; }
.lb-table tr.me td { color: var(--accent); }
.lb-table tr.me td.d { color: var(--accent); opacity: 0.8; }
.lb-table tr.void td { opacity: 0.5; }
.lb.compact .lb-table td.d, .lb.compact .lb-table th.d, .lb.compact .lb-table td.a { display: none; }
.lb.compact .lb-head { flex-direction: column; align-items: flex-start; gap: 4px; }
.lb.compact .lb-scopes .tab { padding: 5px 7px; font-size: 12px; }
.lb-empty { padding: 14px 8px; color: var(--muted); font-size: 13px; border-top: 1px solid var(--line); }
.lb-rules { color: var(--muted); font-size: 12px; line-height: 1.45; margin: 4px 0 0; }
.lb-kinds { display: flex; gap: 6px; }
.lb-filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: -6px 0 4px; }
.lb-filters select { min-width: 0; }
.lb-filters small { color: var(--muted); }
.lb-link { background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; font-size: 12px; padding: 0; align-self: flex-start; }
.lb-run { width: min(620px, 100%); background: var(--panel-solid); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 16px; margin-bottom: 14px; display: flex; flex-direction: column; gap: 4px; font-size: 14.5px; }
.lb-run .pb { color: var(--accent); font-weight: 800; }
.lb-run .bad { color: var(--warn); }
.lb-run .online { color: var(--muted); font-size: 13px; }
.lb-run .btn { align-self: flex-start; margin-top: 4px; }
.lb-results { width: min(760px, 100%); margin-bottom: 18px; }
.lb-screen { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: 22px; align-items: start; }
.lb-list { display: flex; flex-direction: column; gap: 2px; max-height: calc(100vh - 150px); overflow-y: auto; padding-right: 4px; }
.lb-list h4 { margin: 12px 0 4px; font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }
.lb-list h4:first-child { margin-top: 0; }
.lb-list .list-btn { text-align: left; background: transparent; border: 0; border-left: 3px solid transparent; color: var(--text); padding: 7px 10px; cursor: pointer; border-radius: 0 6px 6px 0; font-size: 14px; }
.lb-list .list-btn:hover { background: rgba(255, 255, 255, 0.06); }
.lb-list .list-btn.on { border-left-color: var(--accent); background: rgba(255, 207, 63, 0.08); color: var(--accent); }
.lb-list .list-btn small { display: block; color: var(--muted); font-size: 12px; }
.lb-panel { display: flex; flex-direction: column; gap: 14px; }
.lb-pb { font-size: 13px; color: var(--muted); }
.lb-pb b { color: var(--text); font-family: var(--mono); }
.cup-card { display: grid; grid-template-columns: 1fr auto; gap: 6px 18px; align-items: center; }
.cup-card .big { font-size: 22px; font-weight: 800; }
.cup-card .facts { color: #dde2ea; font-size: 14px; line-height: 1.6; }
.cup-medal { display: inline-block; padding: 2px 10px; border-radius: 99px; font-weight: 800; font-size: 12.5px; letter-spacing: 0.06em; text-transform: uppercase; }
.cup-medal.gold { background: linear-gradient(135deg, #fff3b0, #e6b422); color: #3a2a00; }
.cup-medal.silver { background: linear-gradient(135deg, #fff, #c0c6cf); color: #222; }
