function canvasTexture(w: number, h: number, draw: (g: CanvasRenderingContext2D) => void) {\r
  const c = document.createElement('canvas');\r
  c.width = w;\r
  c.height = h;\r
  draw(c.getContext('2d')!);\r
  const tex = new THREE.CanvasTexture(c);\r
  tex.colorSpace = THREE.SRGBColorSpace;\r
  tex.anisotropy = 8;\r
  return tex;\r
}\r
