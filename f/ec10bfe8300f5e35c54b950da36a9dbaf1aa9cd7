        // Seams between panels.\r
        const seam = !dark && best - second < 0.012;\r
        const k = dark ? 20 : seam ? 150 : 245;\r
        const i = (y * W + x) * 4;\r
        img.data[i] = k; img.data[i + 1] = k; img.data[i + 2] = dark ? 24 : k; img.data[i + 3] = 255;\r
      }\r
      g.putImageData(img, 0, 0);\r
    });\r
  });\r
}\r
