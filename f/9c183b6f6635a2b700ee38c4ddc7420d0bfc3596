/** Covered dugout: a bench of seats for the substitutes, glass sides and roof. Returns the seat spots. */\r
function dugout(kit: WorldKit, x0: number, x1: number): Spot[] {\r
  const z0 = 37.55, z1 = 40.9, xm = (x0 + x1) / 2, w = x1 - x0;\r
  kit.box('concreteNew', xm, 0.075, (z0 + z1) / 2, w, 0.15, z1 - z0);\r
  kit.box('concreteNew', xm, 1.25, z1 - 0.1, w, 2.2, 0.2);\r
  for (const x of [x0 + 0.05, x1 - 0.05]) kit.box('glass', x, 1.15, (z0 + z1) / 2 + 0.1, 0.06, 2.0, z1 - z0 - 0.2);\r
  // Roof: a glass shell sloping down to the front edge.\r
  kit.box('glass', xm, 2.22, (z0 + z1) / 2, w, 0.06, z1 - z0 + 0.1, { rot: new THREE.Euler(0.12, 0, 0, 'YXZ') });\r
  kit.box('steelGrey', xm, 2.4, z1 - 0.1, w, 0.12, 0.2);\r
  const spots: Spot[] = [];\r
  const n = Math.floor((w - 0.6) / 0.6);\r
  for (let i = 0; i < n; i++) {\r
    const x = x0 + 0.3 + 0.3 + i * 0.6;\r
    kit.box('black', x, 0.37, z1 - 0.62, 0.48, 0.44, 0.44, { collide: false });\r
    kit.box('black', x, 0.8, z1 - 0.4, 0.48, 0.5, 0.06, { collide: false });\r
    spots.push({ x, y: 0.15, z: z1 - 0.62 + 0.06, yaw: Math.PI });\r
  }\r
  return spots;\r
}\r
