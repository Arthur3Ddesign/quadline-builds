/** Inflatable race arch over the running track: two legs and a beam swept round rounded corners, a banner, guy ropes. */\r
function inflatableArch(kit: WorldKit, banner: THREE.Material, cx: number, cz: number, ax: number, az: number, span: number, H: number) {\r
  const r = 0.42, R = 0.85;\r
  // Path in (across, up).\r
  const path: [number, number][] = [];\r
  const half = span / 2;\r
  path.push([-half, 0], [-half, H - R]);\r
  for (let k = 1; k < 8; k++) {\r
    const a = Math.PI - (k / 8) * (Math.PI / 2);\r
    path.push([-half + R + Math.cos(a) * R, H - R + Math.sin(a) * R]);\r
  }\r
  path.push([-half + R, H], [half - R, H]);\r
  for (let k = 1; k < 8; k++) {\r
    const a = Math.PI / 2 - (k / 8) * (Math.PI / 2);\r
    path.push([half - R + Math.cos(a) * R, H - R + Math.sin(a) * R]);\r
  }\r
  path.push([half, H - R], [half, 0]);\r
  const fx = -az, fz = ax; // running direction (normal to the arch plane)\r
  const W = (a: number, y: number) => V(cx + ax * a, y, cz + az * a);\r
  // Rings of the tube along the path, then each segment goes to the red or the white band.\r
  const n = 12, rings: THREE.Vector3[][] = [], dists: number[] = [];\r
  let dist = 0;\r
  for (let i = 0; i < path.length; i++) {\r
    const [a, y] = path[i];\r
    if (i > 0) dist += Math.hypot(a - path[i - 1][0], y - path[i - 1][1]);\r
    dists.push(dist);\r
    const ring: THREE.Vector3[] = [];\r
    const p0 = path[Math.max(0, i - 1)], p1 = path[Math.min(path.length - 1, i + 1)];\r
    let ta = p1[0] - p0[0], ty = p1[1] - p0[1];\r
    const tl = Math.hypot(ta, ty) || 1;\r
    ta /= tl;\r
    ty /= tl;\r
    // In-plane normal (pointing out of the curve) and the running direction.\r
    const na = ty, ny = -ta;\r
    for (let k = 0; k <= n; k++) {\r
      const t = (k / n) * Math.PI * 2;\r
      const ca = Math.cos(t) * r, cf = Math.sin(t) * r;\r
      const p = W(a + na * ca, y + ny * ca);\r
      ring.push(V(p.x + fx * cf, p.y, p.z + fz * cf));\r
    }\r
    rings.push(ring);\r
  }\r
  for (const [mat, odd] of [['steelRed', 0], ['white', 1]] as const) {\r
    const pos: number[] = [], uv: number[] = [], idx: number[] = [];\r
    for (let i = 0; i < path.length - 1; i++) {\r
      if (Math.floor((dists[i] + dists[i + 1]) / 2 / 1.15) % 2 !== odd) continue;\r
      const b = pos.length / 3;\r
      for (const rr of [rings[i], rings[i + 1]]) for (let k = 0; k <= n; k++) {\r
        pos.push(rr[k].x, rr[k].y, rr[k].z);\r
        uv.push((k / n) * 2.6, dists[i]);\r
      }\r
      for (let k = 0; k < n; k++) {\r
        const a = b + k, c = b + k + 1, d = b + n + 2 + k, e = b + n + 1 + k;\r
        idx.push(a, e, d, a, d, c);\r
      }\r
    }\r
    const g = new THREE.BufferGeometry();\r
    g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));\r
    g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));\r
    g.setIndex(idx);\r
    g.computeVertexNormals();\r
    kit.custom(mat, g);\r
  }\r
  for (let i = 0; i < path.length - 1; i++) {\r
    const a = W(path[i][0], path[i][1]), b = W(path[i + 1][0], path[i + 1][1]);\r
    kit.col.addCapsule(a.x, a.y, a.z, b.x, b.y, b.z, r, 'fabric');\r
  }\r
  // Banner across the beam, both faces.\r
  for (const s of [-1, 1]) {\r
    const bw = span - 2 * R, bh = 0.62;\r
    const pg = new THREE.PlaneGeometry(bw, bh);\r
    const yaw = Math.atan2(ax, az) + (s > 0 ? -Math.PI / 2 : Math.PI / 2);\r
    pg.rotateY(yaw);\r
    const uvb = pg.attributes.uv as THREE.BufferAttribute;\r
    for (let k = 0; k < uvb.count; k++) uvb.setY(k, uvb.getY(k) / 4);\r
    pg.translate(cx + fx * s * (r + 0.02), H, cz + fz * s * (r + 0.02));\r
    kit.addMerged(banner, pg, false);\r
  }\r
  // Blowers at the feet and guy ropes from the top corners.\r
  for (const e of [-1, 1]) {\r
    const foot = W(e * half, 0);\r
    kit.box('black', foot.x + fx * 0.75, 0.2, foot.z + fz * 0.75, 0.45, 0.4, 0.45, { yaw: Math.atan2(ax, az) });\r
    const topc = W(e * (half - 0.1), H - 0.2);\r
    for (const s of [-1, 1]) {\r
      const pin = V(topc.x + fx * s * 2.6, 0.02, topc.z + fz * s * 2.6);\r
      kit.pipe('white', topc, pin, 0.012, { seg: 3 });\r
      kit.box('steelGrey', pin.x, 0.05, pin.z, 0.08, 0.1, 0.08, { collide: false });\r
    }\r
  }\r
}\r
