\r
/** Race gates standing on the pitch (both tracks): the players run round them. */\r
function gatesOnPitch(tracks: TrackDef[]): Obstacle[] {\r
  const out: Obstacle[] = [];\r
  for (const t of tracks) for (const g of t.gates) {\r
    if (Math.abs(g.x) > PL / 2 + 2 || Math.abs(g.z) > PW / 2 + 1) continue;\r
    let r = 0;\r
    if (g.kind === 'arch') r = (g.size ?? 4) / 2 + 0.4;\r
    else if (g.kind === 'hoop') r = (g.elev ?? 2) < 2.2 ? (g.size ?? 3) / 2 + 0.3 : 0.6;\r
    else if (g.kind === 'led' || g.kind === 'square') r = (g.size ?? 1.52) / 2 + 0.5;\r
    else if (g.kind === 'dive') r = (g.size ?? 1.8) / 2 + 0.5;\r
    if (r > 0 && !out.some((o) => Math.hypot(o.x - g.x, o.z - g.z) < 0.1)) out.push({ x: g.x, z: g.z, r });\r
  }\r
